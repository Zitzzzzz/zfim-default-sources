  "scrape": {
    "list": {
      "endpoint": "/c/phim-4k?page={page}",
      "item": ".sw-cover",
      "map": {
        "id": "a.v-thumbnail @href",
        "name": "h4.item-title a @title, h4.item-title a @text, img @alt",
        "poster": "img @src"
      }
    },
    "meta": {
      "endpoint": "/{slug}",
      "map": {
        "name": "h1 @text",
        "poster": "meta[property=\"og:image\"] @content, img[src*=\"cdn.500phim.net\"] @src, img @src",
        "description": "meta[name=\"description\"] @content",
        "videos": {
          "item": "a[href*=\"/xem-phim/\"]",
          "map": {
            "title": "span.ep-title @text, @text",
            "id": "@href"
          }
        }
      }
    },
    "streams": {
      "endpoint": "/{slug}",
      "candidates": {
        "selector": "iframe[src*=\"/embed/\"], iframe, a[href*=\"/xem-phim/\"], video, source",
        "attr": "src, href, data-src"
      }
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "connatix.com",
      "google.com",
      "facebook.com"
    ],
    "bannedTerms": [
      "quangcao",
      "banner",
      "tracking",
      "connatix"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4",
      "chophim.app",
      "kvp",
      "kkphim",
      "v8.streamvsmov",
      "playembed.vip"
    ]
  },
  "streamUnwrapping": [
    "direct-m3u8",
    "embed-iframe"
  ]
}
