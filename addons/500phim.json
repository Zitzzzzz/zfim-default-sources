  "scrape": {
    "list": {
      "endpoint": "/c/phim-4k?page={page}",
      "item": ".sw-cover",
      "map": {
        "id": "a.v-thumbnail @href",
        "name": "h4.item-title a @title, h4.item-title a @text, img @alt",
        "poster": "img @src"
      }
    },
    "meta": {
      "endpoint": "/{slug}",
      "map": {
        "name": "h1 @text",
        "poster": "meta[property=\"og:image\"] @content, img[src*=\"cdn.500phim.net\"] @src, img @src",
        "description": "meta[name=\"description\"] @content",
        "videos": {
          "item": "a.item[href*=\"/xem-phim/\"], a.edition-pill-item[href*=\"/xem-phim/\"]",
          "map": {
            "title": "div.ep-sort @text, span.ep-title @text, span.ep-badge @text, @text",
            "id": "@href"
          }
        }
      }
    },
    "streams": {
      "endpoint": "/{slug}",
      "candidates": {
        "selector": "iframe#embed-player, iframe[src*=\"embed\"], iframe",
        "attr": "src"
      }
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "connatix.com",
      "google.com",
      "facebook.com"
    ],
    "bannedTerms": [
      "quangcao",
      "banner",
      "tracking",
      "connatix"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4",
      "chophim.app",
      "phim1280.tv",
      "darkbytes.xyz",
      "kvp",
      "kkphim",
      "v8.streamvsmov",
      "playembed.vip"
    ]
  },
  "streamUnwrapping": [
    "direct-m3u8",
    "embed-iframe"
  ]
}
