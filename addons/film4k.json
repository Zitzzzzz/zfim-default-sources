{
  "$schema": "zfim/addon-json/v1",
  "kind": "single",
  "id": "film4k",
  "name": "Film4k",
  "version": "1.0.0",
  "description": "Kho phim Film4k (film4k.pl) - Trải nghiệm điện ảnh đỉnh cao với chuẩn 4K Ultra HD (3832x1600 HEVC), âm thanh vòm Dolby Digital Plus (EAC3 5.1), thuyết minh tiếng Việt và phụ đề đa ngôn ngữ tốc độ cao từ Cloudflare CDN",
  "logo": "https://film4k.pl/favicon-32.png",
  "base": "https://film4k.pl",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://film4k.pl/"
  },
  "types": [
    "series",
    "movie"
  ],
  "catalogs": [
    {
      "id": "phim-moi",
      "type": "series",
      "name": "Mới Cập Nhật",
      "endpoint": "/api/home?page={page}"
    },
    {
      "id": "phim-bo-4k",
      "type": "series",
      "name": "Phim Bộ 4K Ultra HD",
      "endpoint": "/api/home?type=tv&page={page}"
    },
    {
      "id": "phim-le-4k",
      "type": "movie",
      "name": "Phim Lẻ 4K Ultra HD",
      "endpoint": "/api/home?type=movie&page={page}"
    },
    {
      "id": "phim-thinh-hanh",
      "type": "movie",
      "name": "Top Thịnh Hành",
      "endpoint": "/api/home"
    },
    {
      "id": "the-loai-hanh-dong",
      "type": "movie",
      "name": "Phim Hành Động",
      "endpoint": "/api/home/genre?genre=Phim%20H%C3%A0nh%20%C4%90%E1%BB%99ng"
    },
    {
      "id": "the-loai-khoa-hoc-vien-tuong",
