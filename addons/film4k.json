    },
    {
      "id": "the-loai-hai",
      "type": "movie",
      "name": "Phim Hài Hước",
      "endpoint": "/api/home/genre?genre=Phim%20H%C3%A0i"
    },
    {
      "id": "the-loai-lang-man",
      "type": "movie",
      "name": "Phim Lãng Mạn",
      "endpoint": "/api/home/genre?genre=Phim%20L%C3%A3ng%20M%E1%BA%A1n"
    },
    {
      "id": "the-loai-chinh-kich",
      "type": "series",
