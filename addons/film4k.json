      "endpoint": "/api/home/genre?genre=Phim%20T%C3%A0i%20Li%E1%BB%87u"
    }
  ],
  "json": {
    "list": {
      "path": "/api/home?page={page}",
      "items": "list",
      "map": {
        "id": "slug",
        "name": "title.vi",
        "poster": "poster.vi",
        "background": "backdrop",
        "description": "overview.vi"
      }
    },
    "meta": {
      "path": "/api/title/{id}",
      "map": {
        "name": "movie.title.vi",
        "poster": "movie.poster.vi",
        "background": "movie.backdrop",
        "description": "movie.overview.vi",
        "episodes": "episodes"
      }
    },
    "streams": {
      "path": "{embed_url}",
      "regexes": [
        "https?://[^\"'\\s]+\\.m3u8",
        "https?://[^\"'\\s]+\\.mp4",
        "/api/hls/[^\"'\\s]+\\.m3u8"
      ]
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "google.com",
      "facebook.com"
    ],
    "bannedTerms": [
      "quangcao",
      "banner"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4",
      "film4knet.ngaodacopho.workers.dev",
      "/api/hls/"
    ]
  },
  "streamUnwrapping": [
    "direct-m3u8"
  ]
}
