    },
    {
      "id": "the-loai-hinh-su",
      "type": "series",
      "name": "Phim Hình Sự",
      "endpoint": "/api/home/genre?genre=Phim%20H%C3%ACnh%20S%E1%BB%B1"
    },
    {
      "id": "the-loai-phieu-luu",
      "type": "movie",
