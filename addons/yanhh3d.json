  "scrape": {
    "list": {
      "endpoint": "/moi-cap-nhat?page={page}",
      "item": ".flw-item, li.item-top",
      "map": {
        "id": "a.film-poster-ahref @href, .film-poster a @href, h3.film-name a @href, a @href",
        "name": "h3.film-name a @text, .film-name a @text, @title",
        "poster": "img.film-poster-img @data-src, img @data-src, img @src"
      }
    },
    "meta": {
      "endpoint": "/{slug}",
      "map": {
        "name": "h1.film-name @text",
        "poster": "img.film-poster-img @data-src",
        "description": ".film-description .text @text",
        "videos": {
          "servers": "ul.sever-ep li a, ul.nav-tabs li a[data-toggle=\"tab\"], .server-tabs a",
          "item": ".ep-item, a.ssl-item",
          "map": {
            "title": "@title",
            "id": "@href"
          }
        }
      }
    },
    "streams": {
      "endpoint": "/{slug}",
      "candidates": {
        "selector": "a.btn3dsv, a.btn-play, iframe, video, source",
        "attr": "data-src",
        "label": "@name"
      }
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "https://bit.ly/yanhh3d",
      "https://raw.githubusercontent.com/Datj0000/domain/refs/heads/main/yanhh3d.txt",
      "https://cdn.jsdelivr.net/gh/Datj0000/domain@main/yanhh3d.txt",
      "https://fastly.jsdelivr.net/gh/Datj0000/domain@main/yanhh3d.txt"
    ],
    "bannedTerms": [
      "quangcao",
      "promo",
      "intro"
    ],
    "falseStreamExts": [
      ".jpg",
      ".png",
      ".webp",
      ".vtt",
      ".svg"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4"
    ]
  },
  "streamUnwrapping": [
    "direct-m3u8"
  ]
}