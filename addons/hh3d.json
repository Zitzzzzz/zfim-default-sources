{
  "$schema": "zfim/addon-json/v1",
  "kind": "single",
  "id": "hh3d",
  "name": "HH3D.com",
  "version": "1.0.0",
  "description": "Kho Hoạt Hình 3D Trung Quốc Vietsub & Thuyết minh tổng hợp từ HH3D.com",
  "logo": "https://www.hh3d.com/storage/files/hh3d_favicon.png",
  "base": "https://www.hh3d.com",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Referer": "https://www.hh3d.com/"
  },
  "types": [
    "series",
    "movie"
  ],
  "catalogs": [
    {
      "id": "tien-hiep",
      "type": "series",
      "name": "Tiên Hiệp",
      "endpoint": "/the-loai/tien-hiep?page={page}"
    },
    {
      "id": "huyen-huyen",
      "type": "series",
      "name": "Huyền Huyễn",
      "endpoint": "/the-loai/huyen-huyen?page={page}"
    },
    {
      "id": "phieu-luu",
      "type": "series",
      "name": "Phiêu Lưu",
      "endpoint": "/the-loai/phieu-luu?page={page}"
    },
    {
      "id": "phim-le",
      "type": "movie",
      "name": "Phim Lẻ",
      "endpoint": "/danh-sach/phim-le?page={page}"
    }
  ],
  "scrape": {
    "list": {
      "endpoint": "/the-loai/tien-hiep?page={page}",
      "item": ".halim-item",
      "map": {
        "id": "a.halim-thumb @href",
        "name": "a.halim-thumb @title",
        "poster": "img @data-src"
      }
    },
    "meta": {
      "endpoint": "/{slug}",
      "map": {
        "name": "h1.entry-title @text",
        "poster": "img.movie-thumb @data-src",
        "description": ".entry-content @text",
        "videos": {
          "item": ".halim-episode a",
          "map": {
            "title": "@title",
            "id": "@href"
          }
        }
      }
    },
    "streams": {
      "endpoint": "{episodeId}",
      "candidates": {
        "selector": "span.streaming-server, .streaming-server",
        "attr": "data-link",
        "label": "@text"
      }
    }
  },
  "streamFilters": {
    "blocklistHosts": [],
    "bannedTerms": [
      "quangcao",
      "promo"
    ],
    "falseStreamExts": [
      ".jpg",
      ".png",
      ".webp",
      ".vtt"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4"
    ]
  },
  "streamUnwrapping": [
    "data-obf",
    "direct-m3u8"
  ]
}
