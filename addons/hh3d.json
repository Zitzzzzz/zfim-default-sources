{
  "$schema": "zfim/addon-json/v1",
  "kind": "single",
  "id": "hh3d",
  "name": "HH3D",
  "version": "1.2.0",
  "description": "Kho Hoạt Hình 3D Trung Quốc Vietsub & Thuyết minh chất lượng cao từ hh3d.com, phân tách server Vietsub/Thuyết minh thông minh và giải mã stream data-obf siêu tốc",
  "logo": "https://www.hh3d.com/storage/files/hh3d_favicon.png",
  "base": "https://www.hh3d.com",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://www.hh3d.com/",
    "Connection": "close"
  },
  "types": [
    "series",
    "movie"
  ],
  "catalogs": [
    {
      "id": "moi-cap-nhat",
      "type": "series",
      "name": "Mới Cập Nhật",
      "endpoint": "/danh-sach/moi-cap-nhat?page={page}"
    },
    {
      "id": "phim-bo",
      "type": "series",
      "name": "Phim Bộ",
      "endpoint": "/danh-sach/phim-bo?page={page}"
    },
    {
      "id": "hoan-thanh",
      "type": "series",
      "name": "Đã Hoàn Thành",
      "endpoint": "/danh-sach/hoan-thanh?page={page}"
    },
    {
      "id": "phim-le",
      "type": "movie",
      "name": "Phim Lẻ | OVA",
      "endpoint": "/danh-sach/phim-le?page={page}"
    }
  ],
  "scrape": {
    "list": {
      "endpoint": "/danh-sach/moi-cap-nhat?page={page}",
      "item": ".halim-item",
      "map": {
        "id": "a.halim-thumb @href",
        "name": "a.halim-thumb @title, .entry-title @text",
        "poster": ".halim-thumb img @data-src, .halim-thumb img @src, img @data-src, img @src"
      }
    },
    "meta": {
      "endpoint": "/{slug}",
      "map": {
        "name": "h1.entry-title @text, .entry-title @text",
        "poster": ".movie-poster img @src, img.movie-thumb @src, .movie-thumb @data-src, img @src",
        "description": ".entry-content @text",
        "released": ".released @text",
        "videos": {
          "servers": "ul.nav-tabs li a",
          "item": "li.halim-episode a, a.halim-btn, a",
          "map": {
            "title": "span @text, @title",
            "id": "@href"
          }
        }
      }
    },
    "streams": {
      "endpoint": "/{slug}",
      "candidates": {
        "selector": "span.streaming-server, .streaming-server, #player-wrapper iframe, iframe",
        "attr": "data-link",
        "label": "@text"
      }
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "facebook.com",
      "google.com"
    ],
    "bannedTerms": [
      "quangcao",
      "promo",
      "intro"
    ],
    "falseStreamExts": [
      ".jpg",
      ".png",
      ".webp",
      ".vtt",
      ".svg"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4",
      "stream",
      "video"
    ]
  },
  "streamUnwrapping": [
    "data-obf",
    "direct-m3u8"
  ]
}
