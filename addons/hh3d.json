{
  "$schema": "zfim/addon-json/v1",
  "kind": "single",
  "id": "hh3d",
  "name": "HH3D",
  "version": "1.1.0",
  "description": "Kho Hoạt Hình 3D Trung Quốc Vietsub & Thuyết minh chất lượng cao từ hh3d.com, phân loại server Vietsub/Thuyết minh thông minh và giải mã stream data-obf siêu tốc",
  "logo": "https://www.hh3d.com/storage/files/hh3d_favicon.png",
  "base": "https://www.hh3d.com",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://www.hh3d.com/"
  },
  "types": [
    "series",
    "movie"
  ],
  "catalogs": [
    {
      "id": "moi-cap-nhat",
      "type": "series",
      "name": "Mới Cập Nhật",
      "endpoint": "/danh-sach/moi-cap-nhat?page={page}"
    },
    {
      "id": "phim-bo",
      "type": "series",
      "name": "Phim Bộ",
      "endpoint": "/danh-sach/phim-bo?page={page}"
    },
    {
      "id": "hoan-thanh",
      "type": "series",
      "name": "Đã Hoàn Thành",
      "endpoint": "/danh-sach/hoan-thanh?page={page}"
    },
    {
      "id": "phim-le",
      "type": "movie",
      "name": "Phim Lẻ | OVA",
      "endpoint": "/danh-sach/phim-le?page={page}"
    },
    {
      "id": "tien-hiep",
      "type": "series",
      "name": "Tiên Hiệp",
      "endpoint": "/the-loai/tien-hiep?page={page}"
    },
    {
      "id": "huyen-huyen",
      "type": "series",
      "name": "Huyền Huyễn",
      "endpoint": "/the-loai/huyen-huyen?page={page}"
    },
    {
      "id": "trung-sinh",
      "type": "series",
      "name": "Trùng Sinh",
      "endpoint": "/the-loai/trung-sinh?page={page}"
    },
    {
      "id": "xuyen-khong",
      "type": "series",
      "name": "Xuyên Không",
      "endpoint": "/the-loai/xuyen-khong?page={page}"
    },
    {
      "id": "luyen-cap",
      "type": "series",
      "name": "Luyện Cấp",
      "endpoint": "/the-loai/luyen-cap?page={page}"
    },
    {
      "id": "he-thong",
      "type": "series",
      "name": "Hệ Thống",
      "endpoint": "/the-loai/he-thong?page={page}"
    },
    {
      "id": "kiem-hiep",
      "type": "series",
      "name": "Kiếm Hiệp",
      "endpoint": "/the-loai/kiem-hiep?page={page}"
    },
    {
      "id": "di-gioi",
      "type": "series",
      "name": "Dị Giới",
      "endpoint": "/the-loai/di-gioi?page={page}"
    }
  ],
  "scrape": {
    "list": {
      "endpoint": "/danh-sach/moi-cap-nhat?page={page}",
      "item": ".halim-item",
      "map": {
        "id": "a.halim-thumb @href",
        "name": "a.halim-thumb @title",
        "poster": "img @data-src, img @src"
      }
    },
    "meta": {
      "endpoint": "/{slug}",
      "map": {
        "name": "h1.entry-title @text, .entry-title @text",
        "poster": "img.movie-thumb @src, img.movie-thumb @data-src, img.post-thumb @data-src, img @src",
        "description": ".entry-content @text",
        "videos": {
          "servers": "ul.nav-tabs li a, .halim-server-title",
          "item": "ul.halim-list-eps li.halim-episode a, .halim-list-eps a",
          "map": {
            "title": "@title, span @text",
            "id": "@href"
          }
        }
      }
    },
    "streams": {
      "endpoint": "/{slug}",
      "candidates": {
        "selector": "span.streaming-server, .streaming-server, #player-wrapper iframe, iframe",
        "attr": "data-link",
        "label": "@text"
      }
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "facebook.com",
      "google.com"
    ],
    "bannedTerms": [
      "quangcao",
      "promo",
      "intro"
    ],
    "falseStreamExts": [
      ".jpg",
      ".png",
      ".webp",
      ".vtt",
      ".svg"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4",
      "stream",
      "video"
    ]
  },
  "streamUnwrapping": [
    "data-obf",
    "direct-m3u8"
  ]
}
