  "json": {
    "list": {
      "path": "/danh-sach/phim-moi-cap-nhat?page={page}",
      "items": "items",
      "map": {
        "id": "slug",
        "name": "name",
        "poster": "poster_url",
        "background": "thumb_url",
        "description": "origin_name"
      }
    },
    "meta": {
      "path": "/phim/{slug}",
      "map": {
        "name": "movie.name",
        "poster": "movie.poster_url",
        "background": "movie.thumb_url",
        "description": "movie.content",
        "episodes": "episodes"
      },
      "extraSources": [
        {
          "label": "NguonC",
          "path": "https://phim.nguonc.com/api/film/{slug}",
          "episodes": "movie.episodes"
        },
        {
          "label": "VSMOV",
          "path": "https://vsmov.com/api/phim/{slug}",
          "episodes": "episodes"
        }
      ],
      "fallbackSources": [
        {
          "prefix": "cam:",
          "path": "https://rahjnkzpevnqqnddxnll.supabase.co/rest/v1/curated_movies?slug=eq.{slug}&status=eq.published&select=*&apikey=sb_publishable_m6tRZ4RfXtTdKpx-pK9UbA_JEGaX9Ae"
        }
      ]
    },
    "streams": {
      "path": "/phim/{slug}",
      "regexes": [
        "https?:\\/\\/[^\"'\\s]+\\.m3u8[^\"'\\s]*",
        "https?:\\/\\/[^\"'\\s]+\\.mp4[^\"'\\s]*"
      ]
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "doubleclick.net",
      "googlesyndication.com",
      "adservice.google.com"
    ],
    "bannedTerms": [
      "quangcao",
      "banner"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4"
    ]
  }
