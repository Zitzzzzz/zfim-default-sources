{
  "$schema": "zfim/addon-json/v1",
  "kind": "single",
  "id": "kkphim",
  "name": "KKPhim",
  "version": "1.3.1",
  "description": "Kho phim điện ảnh, phim bộ, hoạt hình từ PhimAPI (phimapi.com / kkphim.com) - Chuẩn mực 20 chuyên mục phong phú, poster điện ảnh 2:3 chuẩn sắc nét, direct HLS link_m3u8 siêu tốc",
  "logo": "https://phimapi.com/favicon.ico",
  "base": "https://phimapi.com",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://player.phimapi.com/",
    "Origin": "https://player.phimapi.com"
  },
  "types": [
    "series",
    "movie"
  ],
  "catalogs": [
