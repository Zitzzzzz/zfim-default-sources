    }
  ],
  "json": {
    "list": {
      "path": "/v1/api/danh-sach/phim-moi-cap-nhat?page={page}",
      "items": "data.items",
      "map": {
        "id": "slug",
        "name": "name",
        "poster": "poster_url",
        "background": "thumb_url",
        "description": "origin_name"
      }
    },
    "meta": {
      "path": "/phim/{slug}",
      "map": {
        "name": "movie.name",
        "poster": "movie.poster_url",
        "background": "movie.thumb_url",
        "description": "movie.content",
        "episodes": "episodes"
      }
    },
    "streams": {
      "path": "/phim/{slug}",
      "regexes": [
        "https?:\\/\\/[^\"'\\s]+\\.m3u8[^\"'\\s]*",
        "https?:\\/\\/[^\"'\\s]+\\.mp4[^\"'\\s]*"
      ]
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "ads.example.com",
      "doubleclick.net",
      "googlesyndication.com"
    ],
    "bannedTerms": [
      "quangcao",
      "promo",
      "intro"
    ],
    "falseStreamExts": [
      ".jpg",
      ".png",
      ".webp",
      ".vtt",
      ".svg"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4"
    ]
  },
  "streamUnwrapping": [
    "direct-m3u8",
    "streamc"
  ]
}
