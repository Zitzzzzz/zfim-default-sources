{
  "$schema": "zfim/addon-json/v1",
  "kind": "single",
  "id": "vieflix",
  "name": "VieFlix",
  "version": "1.0.0",
  "description": "Kho phim VieFlix (vieflix.buzz / vieflix.com) - Vũ trụ giải trí điện ảnh chuẩn GenZ với hơn 30.000 phim, đa server phát (KKPhim, NguonC, OnFlix, ViCDN, VSPhim), poster dọc 2:3 chuẩn điện ảnh sắc nét, phân loại phong phú",
  "logo": "https://vieflix.buzz/images/logo.webp",
  "base": "https://vieflix.buzz",
  "dynamicDomainUrl": "https://www.vieflix.com/constant.js",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
    "Referer": "https://vieflix.buzz/"
  },
  "types": [
    "series",
    "movie"
  ],
  "catalogs": [
