  "json": {
    "list": {
      "path": "/api/movies?page={page}",
      "items": "data.items",
      "map": {
        "id": "slug",
        "name": "name",
        "poster": "posterUrl",
        "background": "thumbUrl",
        "description": "content"
      }
    },
    "meta": {
      "path": "/api/movies/{slug}",
      "map": {
        "name": "data.name",
        "poster": "data.posterUrl",
        "background": "data.thumbUrl",
        "description": "data.content",
        "episodes": "data.sources"
      }
    },
    "streams": {
      "path": "{embed_url}",
      "regexes": [
        "https?://[^\"'\\s]+\\.m3u8",
        "https?://[^\"'\\s]+\\.mp4"
      ]
    }
  }
