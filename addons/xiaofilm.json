  "scrape": {
    "list": {
      "endpoint": "/phim-bo?page={page}",
      "item": ".sw-item",
      "map": {
        "id": "a.v-thumbnail @href",
        "name": "h4.item-title a @title, h4.item-title a @text",
        "poster": "img @src"
      }
    },
    "meta": {
      "endpoint": "/{slug}",
      "map": {
        "name": "h1 @text",
        "poster": "meta[property=\"og:image\"] @content, img[src*=\"/images/m/thumb/\"] @src",
        "description": "meta[name=\"description\"] @content",
        "videos": {
          "item": "a.button-play, a[href*=\"/xem-phim/\"]",
          "map": {
            "title": "@text",
            "id": "@href"
          }
        }
      }
    },
    "streams": {
      "endpoint": "/{slug}",
      "candidates": {
        "selector": "a.button-play, a[href*=\"/xem-phim/\"], iframe, video, source",
        "attr": "src, data-src, href"
      }
    }
  },
  "streamFilters": {
    "bannedTerms": [
      "quangcao",
      "banner"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4"
    ]
  },
  "streamUnwrapping": [
    "direct-m3u8"
  ]
