  "json": {
    "list": {
      "path": "/api/films/phim-moi-cap-nhat?page={page}",
      "items": "items",
      "map": {
        "id": "slug",
        "name": "name",
        "poster": "thumb_url_webp",
        "background": "poster_url_webp",
        "description": "description"
      }
    },
    "meta": {
      "path": "/api/film/{slug}",
      "map": {
        "name": "movie.name",
        "poster": "movie.thumb_url_webp",
        "background": "movie.poster_url_webp",
        "description": "movie.description",
        "episodes": "movie.episodes"
      }
    },
    "streams": {
      "path": "/api/film/{slug}",
      "regexes": [
        "https?:\\/\\/[^\"'\\s]+\\.m3u8[^\"'\\s]*",
        "https?:\\/\\/[^\"'\\s]+\\.mp4[^\"'\\s]*"
      ]
    }
  },
  "streamFilters": {
    "blocklistHosts": [
      "ads.example.com",
      "doubleclick.net",
      "googlesyndication.com"
    ],
    "bannedTerms": [
      "quangcao",
      "promo",
      "intro"
    ],
    "falseStreamExts": [
      ".jpg",
      ".png",
      ".webp",
      ".vtt",
      ".svg"
    ],
    "allowedIndicators": [
      ".m3u8",
      ".mp4"
    ]
  },
  "streamUnwrapping": [
    "direct-m3u8",
    "streamc"
  ]
}
