{
  "$schema": "zfim/addon-json/v1",
  "kind": "single",
  "id": "hhpanda",
  "name": "HHPanda 4K",
  "version": "1.0.1",
  "description": "Kho Hoạt Hình 3D Trung Quốc từ HHPanda (hhpanda.st) chất lượng 4K siêu nét, tự động cập nhật tên miền mới qua hhpanda.me",
  "logo": "https://hhpanda.st/wp-content/uploads/2024/10/logo.webp",
  "base": "https://hhpanda.st",
  "dynamicDomainUrl": "https://hhpanda.me/",
  "dynamicDomainSelector": "a.cta-btn @href, #siteUrl @text",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36",
    "Referer": "https://hhpanda.st/"
  },
  "types": [
    "series",
    "movie"
  ],
  "catalogs": [
    {
      "id": "moi-cap-nhat",
      "type": "series",
      "name": "Mới Cập Nhật",
      "endpoint": "/moi-cap-nhat/page/{page}"
    },
    {
      "id": "most-viewed",
      "type": "series",
      "name": "Xem Nhiều Nhất",
      "endpoint": "/most-viewed/page/{page}"
    },
    {
      "id": "hoan-thanh",
      "type": "series",
      "name": "Đã Hoàn Thành",
      "endpoint": "/hoan-thanh/page/{page}"
    },
    {
      "id": "tu-tien",
      "type": "series",
      "name": "Tu Tiên",
      "endpoint": "/the-loai/tu-tien/page/{page}"
    },
    {
      "id": "kiem-hiep",
      "type": "series",
      "name": "Kiếm Hiệp",
      "endpoint": "/the-loai/kiem-hiep/page/{page}"
    },
    {
      "id": "co-trang",
      "type": "series",
      "name": "Cổ Trang",
      "endpoint": "/the-loai/co-trang/page/{page}"
    },
    {
      "id": "huyen-huyen",
      "type": "series",
      "name": "Huyền Huyễn",
      "endpoint": "/the-loai/huyen-huyen/page/{page}"
    },
    {
      "id": "khoa-huyen",
      "type": "series",
      "name": "Khoa Huyễn",
      "endpoint": "/the-loai/khoa-huyen/page/{page}"
    },
    {
      "id": "ky-ao",
      "type": "series",
      "name": "Kỳ Ảo",
      "endpoint": "/the-loai/ky-ao/page/{page}"
    },
    {
      "id": "do-thi",
      "type": "series",
      "name": "Đô Thị",
      "endpoint": "/the-loai/do-thi/page/{page}"
    },
    {
      "id": "huyen-nghi",
      "type": "series",
      "name": "Huyền Nghi",
      "endpoint": "/the-loai/huyen-nghi/page/{page}"
    },
    {
      "id": "canh-ky",
      "type": "series",
      "name": "Cạnh Kỹ",
      "endpoint": "/the-loai/canh-ky/page/{page}"
    },
    {
      "id": "da-su",
      "type": "series",
      "name": "Dã Sử",
      "endpoint": "/the-loai/da-su/page/{page}"
    },
    {
      "id": "dong-nhan",
      "type": "series",
      "name": "Đồng Nhân",
      "endpoint": "/the-loai/dong-nhan/page/{page}"
    }
  ],
  "scrape": {
    "list": {
      "endpoint": "/page/{page}",
      "item": "article.grid-item, .halim-item, article",
      "map": {
        "id": "a.halim-thumb @href",
        "name": "a.halim-thumb @title, .entry-title @text, a.halim-thumb @text",
        "poster": "img.film-poster-img @src, figure img @src, img @src, img @data-src"
      }
    },
    "meta": {
      "endpoint": "/{slug}",
      "map": {
        "name": "h1 @text, h1.entry-title @text, .entry-title @text",
        "poster": "figure img @src, .film-poster-img @src, img @src",
        "description": ".entry-content @text",
        "videos": {
          "servers": "#halim-ajax-list-server .get-eps, span.halim-server-name, .btn3dsv",
          "item": "li.halim-episode a, a.halim-btn, a[href*='watch-']",
          "map": {
            "title": "@title, span @text, @text",
            "id": "@href"
          }
        }
      }
    },
    "streams": {
      "endpoint": "/{slug}",
      "candidates": {
        "selector": "a.halim-btn, a[href*='watch-'], iframe, .metaframe, .button-watch a",
        "attr": "href, src",
        "label": "@text, @title"
      }
    }
  }
}
