  "scrape": {
    "list": {
      "endpoint": "/api/film/danh-sach/phim-moi-cap-nhat?page={page}",
      "item": ".movie-card-wrapper",
      "map": {
        "id": "a.movie-card @href, a @href",
        "name": "img @alt, .movie-title @text, h3 @text",
        "poster": "img @src, img @data-src"
      }
    },
    "search": {
      "endpoint": "/api/film/tim-kiem?keyword={query}&page={page}",
      "item": ".movie-card-wrapper",
      "map": {
        "id": "a.movie-card @href, a @href",
        "name": "img @alt, .movie-title @text, h3 @text",
        "poster": "img @src, img @data-src"
      }
    },
    "meta": {
      "endpoint": "/phim/{slug}",
      "map": {
        "name": "h1 @text",
        "poster": "img @src"
      }
    },
    "streams": {
      "endpoint": "/xem/{slug}",
      "candidates": {
        "selector": "iframe[src], video source[src]",
        "attr": "src,data-src",
        "label": "@title"
      }
    }
  },
  "streamFilters": {
    "blocklistHosts": [],
    "bannedTerms": [],
    "allowedIndicators": [
      ".m3u8",
      ".mp4",
      "/public/m3u8/",
      "phim1280",
      "chophim-cdn"
    ]
  }
